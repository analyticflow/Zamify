@model Zamify.Models.Question

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Delete Question</title>
    <style>
        /* Main Styling */
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            line-height: 1.6;
            color: #333;
            background-color: #f8f9fa;
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        .container {
            max-width: 900px;
            width: 90%;
            background-color: #fff;
            border-radius: 8px;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
            padding: 30px;
            margin: 20px;
        }

        h1 {
            color: #2c3e50;
            text-align: center;
            margin-bottom: 30px;
            padding-bottom: 15px;
            border-bottom: 2px solid #eaeaea;
        }

        h3 {
            color: #e74c3c;
            text-align: center;
            margin-bottom: 20px;
        }

        h4 {
            color: #3498db;
            text-align: center;
            margin-bottom: 30px;
        }

        .details-grid {
            display: grid;
            grid-template-columns: 200px 1fr;
            gap: 15px;
            margin-bottom: 30px;
        }

        .detail-label {
            font-weight: 600;
            color: #2c3e50;
            text-align: right;
            padding-right: 20px;
        }

        .detail-value {
            padding: 8px 0;
            border-bottom: 1px solid #eee;
        }

        .action-buttons {
            text-align: center;
            margin-top: 30px;
        }

        .btn {
            display: inline-block;
            font-weight: 400;
            text-align: center;
            vertical-align: middle;
            cursor: pointer;
            padding: 8px 16px;
            font-size: 14px;
            border-radius: 4px;
            transition: all 0.2s;
            border: none;
            text-decoration: none;
        }

        .btn-danger {
            background-color: #e74c3c;
            color: #fff;
        }

            .btn-danger:hover {
                background-color: #c0392b;
            }

        .btn-secondary {
            color: #3498db;
            background-color: transparent;
            border: 1px solid #3498db;
        }

            .btn-secondary:hover {
                background-color: #f0f7fd;
            }

        hr {
            border: 0;
            height: 1px;
            background-color: #eaeaea;
            margin: 20px 0;
        }

        form {
            display: inline;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Delete Question</h1>
        <h3>Are you sure you want to delete this?</h3>
        <h4>This action cannot be undone</h4>

        <div class="details-grid">
            <div class="detail-label">@Html.DisplayNameFor(model => model.QuestionText)</div>
            <div class="detail-value">@Html.DisplayFor(model => model.QuestionText)</div>

            <div class="detail-label">@Html.DisplayNameFor(model => model.OptionA)</div>
            <div class="detail-value">@Html.DisplayFor(model => model.OptionA)</div>

            <div class="detail-label">@Html.DisplayNameFor(model => model.OptionB)</div>
            <div class="detail-value">@Html.DisplayFor(model => model.OptionB)</div>

            <div class="detail-label">@Html.DisplayNameFor(model => model.OptionC)</div>
            <div class="detail-value">@Html.DisplayFor(model => model.OptionC)</div>

            <div class="detail-label">@Html.DisplayNameFor(model => model.OptionD)</div>
            <div class="detail-value">@Html.DisplayFor(model => model.OptionD)</div>

            <div class="detail-label">@Html.DisplayNameFor(model => model.CorrectOption)</div>
            <div class="detail-value">@Html.DisplayFor(model => model.CorrectOption)</div>

            <div class="detail-label">@Html.DisplayNameFor(model => model.CreatedDate)</div>
            <div class="detail-value">@Html.DisplayFor(model => model.CreatedDate)</div>

            <div class="detail-label">@Html.DisplayNameFor(model => model.UpdatedDate)</div>
            <div class="detail-value">@Html.DisplayFor(model => model.UpdatedDate)</div>

            <div class="detail-label">@Html.DisplayNameFor(model => model.Subject)</div>
            <div class="detail-value">@Html.DisplayFor(model => model.Subject.Id)</div>
        </div>

        <hr />

        <div class="action-buttons">
            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <input type="submit" value="Delete" class="btn btn-danger" />
            </form>
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </div>
</body>
</html>