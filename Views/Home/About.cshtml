
@{
    ViewData["Title"] = "About";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<section class="about-section section-padding" id="about">
    <div class="container">
        <div class="row">

            <div class="col-lg-6 col-12">
                <h2 class="mb-4">About Us</h2>
                <p>
                    Welcome to our Online Examination System, a secure and efficient platform designed to revolutionize the assessment process.
                    Our system provides a seamless way for educators to create, manage, and evaluate exams while ensuring a smooth experience for students.
                </p>
                <p>
                    With role-based access, automated grading, and real-time monitoring, we aim to make online assessments more reliable and stress-free.
                    Whether you're a student preparing for an exam, a teacher managing test papers, or an administrator overseeing the process, our platform ensures a hassle-free and transparent system.
                </p>
                <p>
                    Join us in transforming the way assessments are conducted, making education more accessible and technology-driven!
                </p>
            </div>

            <div class="col-lg-6 col-12">
                <div class="custom-block bg-white shadow-lg p-4 text-center">
                    <h5 class="mb-3">Our Vision & Mission</h5>
                    <img src="~/images/online-exam-software.jpg" class="img-fluid rounded" alt="Vision & Mission">
                </div>
            </div>
        </div>
    </div>
</section>


