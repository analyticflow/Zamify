<div class="min-h-screen bg-white">

    <!-- Hero Section -->

    <div class="relative bg-gradient-to-b from-purple-50 to-indigo-100 pt-32 pb-20">
        <div class="max-w-7xl mx-auto text-center px-6">
            <h1 class="text-6xl font-extrabold text-gray-900 leading-tight">
                Transform Your <span class="text-indigo-700">Examinations</span>
            </h1>
            <p class="mt-4 text-lg text-gray-800 max-w-2xl mx-auto">
                An innovative online exam platform designed to streamline exam creation, administration, and grading.
            </p>
            <div class="mt-6">
                <button class="ml-4 bg-white border border-indigo-400 text-indigo-600 px-8 py-3 rounded-lg text-lg font-semibold shadow-md hover:bg-indigo-100 transition-all">
                    Learn More
                </button>
            </div>
        </div>
    </div>

    <!-- Features Section -->

    <div class="py-8 bg-white-50">
        <div id="features" class="relative bg-gradient-to-b from-purple-50 to-indigo-100 pt-32 pb-20">
            <div class="max-w-7xl mx-auto text-center">
                <h2 class="text-indigo-600 font-semibold text-lg uppercase">Features</h2>
                <p class="text-3xl font-bold text-gray-900 mt-2">Powerful tools for online assessments</p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-10 max-w-6xl mx-auto">
                <div class="bg-white p-6 shadow-md rounded-lg text-center">
                    <h3 class="text-xl font-semibold text-indigo-600">Secure Examinations</h3>
                    <p class="text-gray-700 mt-2">Advanced security features to prevent cheating.</p>
                </div>
                <div class="bg-white p-6 shadow-md rounded-lg text-center">
                    <h3 class="text-xl font-semibold text-indigo-600">Real-time Monitoring</h3>
                    <p class="text-gray-700 mt-2">Track student progress live during exams.</p>
                </div>
                <div class="bg-white p-6 shadow-md rounded-lg text-center">
                    <h3 class="text-xl font-semibold text-indigo-600">Automated Grading</h3>
                    <p class="text-gray-700 mt-2">Instant results and analytics for exams.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Roles Section -->
    <div class="py-8 bg-white-50">
        <div id="roles" class="relative bg-gradient-to-b from-purple-50 to-indigo-100 pt-32 pb-20">
            <div class="max-w-7xl mx-auto text-center">
                <h2 class="text-indigo-600 font-semibold text-lg uppercase">Roles</h2>
                <p class="text-3xl font-bold text-gray-900 mt-2">Who can use ExamMaster?</p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-10 max-w-6xl mx-auto">
                <div class="bg-white p-6 shadow-md rounded-lg text-center">
                    <h3 class="text-xl font-semibold text-indigo-600">Admin</h3>
                    <p class="text-gray-700 mt-2">Manage users, exams, and reports.</p>
                </div>
                <div class="bg-white p-6 shadow-md rounded-lg text-center">
                    <h3 class="text-xl font-semibold text-indigo-600">Teacher</h3>
                    <p class="text-gray-700 mt-2">Create, manage, and grade exams.</p>
                </div>
                <div class="bg-white p-6 shadow-md rounded-lg text-center">
                    <h3 class="text-xl font-semibold text-indigo-600">Student</h3>
                    <p class="text-gray-700 mt-2">Take exams and review results.</p>
                </div>
            </div>
        </div>
    </div>


    <!-- Testimonials -->

    <div id="testimonials" class="relative bg-gradient-to-b from-purple-50 to-indigo-100 pt-32 pb-20">
        <div class="max-w-7xl mx-auto text-center">
            <h2 class="text-indigo-600 font-semibold text-lg uppercase">Testimonials</h2>
            <p class="text-3xl font-bold text-gray-900 mt-2">What our users say</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-10 max-w-6xl mx-auto">
            <div class="bg-white p-6 shadow-md rounded-lg">
                <p class="text-gray-700 italic">"ExamMaster has revolutionized the way we conduct assessments. Highly recommended!"</p>
                <p class="text-indigo-600 font-semibold mt-4">- John Doe, University Professor</p>
            </div>
            <div class="bg-white p-6 shadow-md rounded-lg">
                <p class="text-gray-700 italic">"A seamless, secure, and intuitive exam system. The automation is a game-changer!"</p>
                <p class="text-indigo-600 font-semibold mt-4">- Sarah Lee, High School Teacher</p>
            </div>
        </div>

    </div>
</div>

 @model List<(string Year, string Event)>

@{
    var faqs = new List<(string Question, string Answer)>
    {
        ("What services do you offer?", "We provide web development and design solutions."),
        ("How can I contact support?", "You can reach us via email or phone."),
        ("Do you offer custom solutions?", "Yes, we tailor our services to your needs.")
    };
}

<div class="max-w-4xl mx-auto p-6">
    <div class="my-8">
        <h2 class="text-2xl font-bold mb-4">Frequently Asked Questions</h2>
        <div class="space-y-4">
            @foreach (var faq in faqs)
            {
                <details class="border p-4 rounded-md">
                    <summary class="font-semibold cursor-pointer">@faq.Question</summary>
                    <p class="text-gray-600 mt-2">@faq.Answer</p>
                </details>
            }
        </div>
    </div>

    <div class="my-8">
        <h2 class="text-2xl font-bold mb-4">Contact Us</h2>
        <div class="border p-6 rounded-md space-y-4 bg-gray-100">
            <div class="flex items-center gap-3">
                <span class="text-blue-500">📧</span>
                <p>contact@company.com</p>
            </div>
            <div class="flex items-center gap-3">
                <span class="text-blue-500">📞</span>
                <p>+1 234 567 890</p>
            </div>
            <div class="flex items-center gap-3">
                <span class="text-blue-500">📍</span>
                <p>123 Business Street, NY</p>
            </div>
        </div>
    </div>
</div>
