@model Zamify.Models.Subject
@{
    ViewData["Title"] = "Subject Details";
    Layout = "~/Views/Shared/_TeacherSidebar.cshtml";

}

<div class="page-header">
    <h1>Subject Details</h1>
</div>

<div class="details-container">
    <div class="card">
        <div class="card-header bg-light">
            <h4 class="mb-0">@Model.Name</h4>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Name)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Name)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.CreatedDate)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.CreatedDate)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.UpdatedDate)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.UpdatedDate)</dd>
            </dl>
        </div>
        <div class="card-footer bg-light">
            <div class="d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">
                    <i class="bi bi-pencil me-1"></i>Edit
                </a>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Back to List
                </a>
            </div>
        </div>
    </div>
</div>