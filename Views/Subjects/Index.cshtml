@model IEnumerable<Zamify.Models.Subject>
@{
    ViewData["Title"] = "Subjects";
    Layout = "~/Views/Shared/_TeacherSidebar.cshtml";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <h1>Subjects</h1>
    <div>
        <a asp-action="Create" class="btn btn-primary me-2">
            <i class="bi bi-plus-circle me-1"></i>Create New Subject
        </a>
        <a asp-controller="Exams" asp-action="Index" class="btn btn-success">
            <i class="bi bi-clipboard-plus me-1"></i>Create Exam
        </a>
        <a asp-controller="Questions" asp-action="Index" class="btn btn-warning text-white">
            <i class="bi bi-question-circle me-1"></i>Create Questions
        </a>
    </div>
</div>

<div class="card shadow">
    <div class="card-body p-0">
        <table class="table table-striped table-hover mb-0">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Name)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.CreatedDate)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.UpdatedDate)
                    </th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.Name)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.CreatedDate)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.UpdatedDate)
                        </td>
                        <td class="table-action-links">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="action-edit" title="Edit">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="action-details" title="Details">
                                <i class="bi bi-info-circle"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="action-delete" title="Delete">
                                <i class="bi bi-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
