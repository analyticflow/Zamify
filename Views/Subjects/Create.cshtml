

@model Zamify.Models.Subject
@{
    ViewData["Title"] = "Create Subject";
    Layout = "~/Views/Shared/_TeacherSidebar.cshtml";

}

<div class="page-header">
    <h1>Create Subject</h1>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="form-container">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" placeholder="Enter subject name" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle me-1"></i>Create
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left me-1"></i>Back to List
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@* @section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
} *@

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Show pop-up for duplicates
        $(document).ready(function () {
            $('form').submit(function (e) {
                var name = $('#Name').val().trim();
                var currentId = $('#Id').val() || 0;

                // Check duplicates via AJAX
                $.ajax({
                    url: '/Subjects/VerifySubject',
                    data: { name: name, id: currentId },
                    async: false
                }).done(function (response) {
                    if (response !== true) {
                        alert(response); // Show pop-up
                        e.preventDefault(); // Block form submission
                    }
                });
            });
        });
    </script>
}