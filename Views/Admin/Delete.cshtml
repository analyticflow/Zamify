@model Zamify.Models.Teacher
@{
    ViewData["Title"] = "Delete Teacher";
    Layout = null;
}

<div class="container py-4">
    <div class="card shadow-sm">
        <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">
            <h3 class="card-title mb-0">Delete Teacher</h3>
        </div>

        <div class="card-body">
            <div class="alert alert-warning mb-4">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <strong>Warning:</strong> Are you sure you want to delete this teacher? This action cannot be undone.
            </div>

            <div class="row">
                <div class="col-md-4 text-center mb-4 mb-md-0">
                    <div class="avatar-placeholder mb-3">
                        <i class="bi bi-person-circle"></i>
                    </div>
                    <h4>@Model.Name</h4>
                    <p class="text-muted">
                        <i class="bi bi-envelope"></i> @Model.Email
                    </p>
                    <div class="badge bg-secondary text-white mb-2">Teacher ID: @Model.Id</div>
                </div>

                <div class="col-md-8">
                    <div class="detail-card">
                        <h5 class="detail-header">
                            <i class="bi bi-info-circle"></i> Teacher Information
                        </h5>
                        <div class="detail-item row">
                            <div class="col-sm-4 detail-label">Full Name</div>
                            <div class="col-sm-8 detail-value">@Model.Name</div>
                        </div>
                        <div class="detail-item row">
                            <div class="col-sm-4 detail-label">Email Address</div>
                            <div class="col-sm-8 detail-value">@Model.Email</div>
                        </div>
                        <div class="detail-item row">
                            <div class="col-sm-4 detail-label">Password</div>
                            <div class="col-sm-8 detail-value">••••••••</div>
                        </div>
                    </div>

                    <div class="detail-card mt-4">
                        <h5 class="detail-header">
                            <i class="bi bi-clock-history"></i> System Information
                        </h5>
                        <div class="detail-item row">
                            <div class="col-sm-4 detail-label">Account Created</div>
                            <div class="col-sm-8 detail-value">
                                @Model.CreatedDate.ToString("MMMM d, yyyy")
                            </div>
                        </div>
                        <div class="detail-item row">
                            <div class="col-sm-4 detail-label">Last Updated</div>
                            <div class="col-sm-8 detail-value">
@*                                 @Model.UpdatedDate.ToString("MMMM d, yyyy")
 *@                         @Model.UpdatedDate?.ToString("MMMM d, yyyy") ?? "N/A"

                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-4 pt-3 border-top">
                <form asp-action="Delete" class="d-flex justify-content-between">
                    <input type="hidden" asp-for="Id" />

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Back to List
                    </a>

                    <div>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-primary me-2">
                            <i class="bi bi-info-circle"></i> View Details
                        </a>
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash-fill"></i> Confirm Delete
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@if (Layout == null)
{
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        :root {
            --primary-color: #3498db;
            --primary-hover: #2980b9;
            --danger-color: #e74c3c;
            --danger-hover: #c0392b;
            --secondary-color: #f8f9fa;
            --text-color: #2c3e50;
            --light-gray: #ecf0f1;
            --border-color: #e9ecef;
            --warning-bg: #fff3cd;
            --warning-border: #ffeeba;
        }

        body {
            background-color: var(--secondary-color);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: var(--text-color);
        }

        .container {
            max-width: 900px;
        }

        .card {
            border-radius: 10px;
            border: none;
            overflow: hidden;
        }

        .card-header {
            background-color: var(--danger-color);
            padding: 1.25rem 1.5rem;
        }

        .card-body {
            padding: 2rem;
        }

        .alert-warning {
            background-color: var(--warning-bg);
            border-color: var(--warning-border);
            border-radius: 8px;
            padding: 1rem;
        }

        .avatar-placeholder {
            width: 120px;
            height: 120px;
            line-height: 120px;
            font-size: 60px;
            background-color: var(--light-gray);
            border-radius: 50%;
            color: #95a5a6;
            display: inline-block;
            margin: 0 auto;
        }

        .detail-card {
            background-color: var(--light-gray);
            border-radius: 8px;
            padding: 1.5rem;
        }

        .detail-header {
            color: var(--text-color);
            margin-bottom: 1rem;
            font-weight: 600;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 0.5rem;
        }

        .detail-item {
            margin-bottom: 0.75rem;
        }

        .detail-label {
            font-weight: 600;
            color: #636e72;
        }

        .detail-value {
            color: var(--text-color);
        }

        .btn-danger {
            background-color: var(--danger-color);
            border-color: var(--danger-color);
        }

            .btn-danger:hover {
                background-color: var(--danger-hover);
                border-color: var(--danger-hover);
            }

        .btn-outline-secondary {
            color: var(--text-color);
            border-color: #ced4da;
        }

            .btn-outline-secondary:hover {
                background-color: var(--light-gray);
                color: var(--text-color);
            }

        .btn-outline-primary {
            color: var(--primary-color);
            border-color: var(--primary-color);
        }

            .btn-outline-primary:hover {
                background-color: var(--primary-color);
                color: white;
            }

        .badge {
            padding: 0.5rem 0.75rem;
            font-weight: 500;
        }
    </style>
}